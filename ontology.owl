  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ayeuna">
    <kataSunda>ayeuna</kataSunda>
    <aksaraKata>ᮃᮚᮩᮔ</aksaraKata>
    <artiIndonesia>sekarang</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#ag_baris_03"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_nguni">
    <kataSunda>nguni</kataSunda>
    <aksaraKata>ᮍᮥᮔᮤ</aksaraKata>
    <artiIndonesia>masa lampau; dahulu</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#ag_baris_02"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_tangan">
    <kataSunda>tangan</kataSunda>
    <aksaraKata>ᮒᮍᮔ᮪</aksaraKata>
    <artiIndonesia>tangan</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_07">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮄᮔ᮪ᮌᮨᮒ᮪ᮊᮨᮅᮔ᮪ ᮔ ᮞᮤᮊ᮪ᮞ ᮊᮔ᮪ᮓᮔ᮪ᮌ᮪ ᮊᮛᮨᮞᮡᮔ᮪, ᮓᮨᮅᮔ᮪ᮌ᮪ ᮄᮞᮨᮅᮞ᮪ᮊᮨᮅᮔ᮪ ᮘᮤᮞᮤ ᮊᮨᮅᮔ ᮊᮥ ᮠᮜᮧᮃᮔ᮪ ᮞᮤ ᮕᮔ᮪ᮌwᮃᮔᮔ᮪, ᮙᮊ ᮔ᮪ᮌᮥᮔᮤ ᮔ᮪ᮌᮛᮧwᮃᮔ᮪ᮌ᮪ ᮒᮔ᮪ᮌᮔ᮪</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingat-ingatlah Siksa Kandang Karesian dan perhatikan dalam agar tidak tergoda di perjalanan,</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ingetkeun na siksa kandang karesyan, deung iseuskeun bisi keuna ku haloan si panghawanan, maka nguni ngarowang tangan</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_08"/>
        <lempirNaskah><![CDATA[<B.2v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-07</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <owl:ObjectProperty rdf:about="http://contoh.org/ontology#terkaitKonsep">
    <rdfs:label xml:lang="id">Terkait Konsep</rdfs:label>
    <rdfs:comment xml:lang="id">Menghubungkan entri kata dengan konsep kamus untuk penelusuran sinonim semantik.</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
    <rdfs:range rdf:resource="http://contoh.org/ontology#KonsepKamus"/>
  </owl:ObjectProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_mantri">
    <kataSunda>mantri</kataSunda>
    <aksaraKata>ᮙᮔ᮪ᮒᮢᮤ</aksaraKata>
    <artiIndonesia>mantri; pejabat</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_14">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮓᮨᮅᮔ᮪ᮌ᮪ ᮙᮊ ᮄᮜᮤᮊ᮪-ᮄᮜᮤᮊ᮪ ᮓᮤᮔ ᮒᮥᮛᮥᮒᮔᮨᮅᮔ᮪, ᮙᮔ᮪ᮒᮢᮤ ᮌᮥᮞ᮪ᮒᮤ ᮊᮞ-ᮃᮞ, ᮘᮚᮔ᮪ᮌ᮪ᮊᮛ, ᮔᮥ ᮙᮛᮨᮊ᮪, ᮌᮤᮛᮔ᮪ᮌ᮪ ᮕᮔ᮪ᮌᮜᮞᮔ᮪, ᮏᮥᮛᮥ ᮜᮥᮊᮤᮞ᮪, ᮕᮔ᮪ᮓ᮪é ᮙᮞ᮪</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dan perihatikanlah mereka yang dapat ditiru perbuatannya: mantri gusti yang terkemuka, bayangkara, yang menghadap, pangalasan, juru lukis, pandai emas</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deung maka ilik-ilik dina turutaneun, mantri gusti kaasa-asa, bayangkara, nu marek, girang pangalasan, juru lukis, pandé mas</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_15"/>
        <lempirNaskah><![CDATA[<A.2v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-14</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </munculDi>
  </EntriLeksikal>
