  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:DatatypeProperty rdf:about="http://contoh.org/ontology#hasTranslation">
    <rdfs:label xml:lang="id">Terjemahan Indonesia</rdfs:label>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_prebu">
    <kataSunda>prebu</kataSunda>
    <aksaraKata>ᮕᮢᮨᮘᮥ</aksaraKata>
    <artiIndonesia>raja; prabu</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_06">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮌᮨᮓ᮪é ᮘ᮪ééᮒ᮪, ᮘᮔ᮪ᮌᮒ᮪ cᮃᮔ᮪ᮌ᮪cᮅᮒ᮪ ᮕᮔ᮪ᮌᮓ᮪wᮃ, ᮞᮥᮌᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮕᮏᮨᮅᮈᮅᮔ᮪ᮌ᮪ ᮓᮨᮅᮔ᮪ᮌ᮪ ᮌᮥᮞ᮪ᮒᮤ ᮘᮢᮠ᮪ᮙᮔ, wᮄᮊᮥᮠᮏᮤ ᮙᮔ᮪ᮌ᮪ᮊᮥᮘᮥᮙᮤ, ᮃᮔᮊ᮪ ᮛᮒᮥ ᮘᮨᮅᮔ᮪ᮌᮁ ᮊᮧᮊᮧᮛᮧ, ᮙᮊ, ᮊᮨᮔ ᮄᮒᮥ ᮌᮥᮛᮥ ᮞᮔ᮪ᮌ᮪ ᮕᮢᮨᮘᮥ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">besar atau kecil, segeralah ber- cangcut dan berpakaian, sebab mungkin kita bertemu dengan gusti brahmana, sebab mungkin kita bertemu dengan gusti brahmana, mangkubumi, putra ratu beungkar kokoro kaya atau miskin, karena itu adalah guru sang prabu</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gedé béét, bangat cangcut pangadwa, sugan urang pajeueung deung gusti brahmana, wikuhaji mangkubumi, anak ratu beunghar kokoro, maka, kena itu guru sang prebu</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_07"/>
        <lempirNaskah><![CDATA[<B.2v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-06</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_jalan">
    <kataSunda>jalan</kataSunda>
    <aksaraKata>ᮏᮜᮔ᮪</aksaraKata>
    <artiIndonesia>jalan</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_03">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ᮔᮔ᮪ᮌ᮪] ᮕᮊᮨᮅᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮢᮨᮒᮊᮨᮅᮔ᮪ ᮓᮤ ᮘᮥᮙᮤ ᮜᮙ᮪ᮘ, cᮃᮔ᮪ᮌ᮪ ᮏᮜᮔ᮪, ᮕᮔ᮪ᮏᮔ᮪ᮌ᮪ ᮒᮏᮥᮁ, ᮕᮊ ᮕᮢᮨᮓᮔ, ᮜᮤᮔᮡᮤᮠ᮪ ᮕᮤᮕᮤᮁ, cᮃᮔ᮪ᮌ᮪ ᮘᮥᮛᮥᮃᮔ᮪ [ᮃ] ᮠᮥᮙ ᮊᮇᮙ᮪éᮃᮔ᮪, ᮞᮓᮕᮔ᮪ ᮊᮛᮊ᮪ᮞ, ᮕᮜᮔ ᮒ ᮠᮥᮛᮤᮕ᮪ ᮠᮤᮛᮥᮕ᮪ ᮞᮧwéᮛ wᮃᮛᮞ᮪, ᮔᮡᮧwᮃᮔ ᮞᮔ᮪ᮌ᮪ ᮙwᮃᮛ ᮠ᮪éᮏᮧ ᮜ᮪éᮙ᮪ᮘᮧᮊ᮪, ᮒᮥᮙᮥwᮅᮠ᮪ ᮞᮁᮘ ᮕᮜ wᮇᮠ᮪-wᮇᮠᮔ᮪, ᮓᮓᮤ ᮔ ᮠᮥᮓᮔ᮪ ᮜᮓᮠ᮪ ᮒᮠᮥᮔ᮪, ᮓéᮊ᮪ ᮙᮊ ᮠᮥᮛᮤᮕ᮪ ᮓᮤ ᮜᮙ᮪ᮘ ᮔ᮪ᮌᮛᮔ᮪ᮔ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">untuk kita menyejahterakan di dunia yang luas, bersih jalan, subur tanaman, cukup sandang, bersih halaman belakang, bersih halaman rumah, ladang terurus, sadapan terpelihara, buahnya yaitu lama hidup, selalu sehat, sumbernya terletak pada manusia sedunia, hijau subur, tumbuh segala macam buah-buahan,</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[nang] pakeun urang ngretakeun di bumi lamba, caang jalan, panjang tajur, paka predana, linyih pipir, caang buruan [a] huma kaoméan, sadapan karaksa, palana ta hurip hirup sowéra waras, nyowana sang mawara héjo lémbok, tumuwuh sarba pala woh-wohan, dadi na hudan ladah tahun, daék maka hurip di lamba ngaranna.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_04"/>
        <lempirNaskah><![CDATA[<B.3r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-03</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_hakan">
    <kataSunda>hakan</kataSunda>
    <aksaraKata>ᮠᮊᮔ᮪</aksaraKata>
    <artiIndonesia>makan; makanan</artiIndonesia>
    <kelasKata>verba</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_29">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮏᮌ ᮅᮛᮔ᮪ᮌ᮪ ᮠ᮪ééᮞ᮪ ᮒᮙ᮪ᮘ ᮒᮥᮔ᮪ᮓᮥᮠ᮪, ᮔ᮪ᮌᮤᮔᮥᮙ᮪ ᮒᮥᮃᮊ᮪ ᮒᮙ᮪ᮘ ᮠᮔᮔ᮪ᮌ᮪, ᮔᮡᮒᮥ ᮒᮙ᮪ᮘ ᮕᮧᮔᮡᮧ, ᮅᮜᮠ᮪ ᮊᮏᮧᮔ᮪ᮌ᮪ᮏᮧᮔ᮪ᮌᮔ᮪ ᮒᮨᮅᮄᮔ᮪ᮌ᮪. ᮒᮤᮔᮨᮅᮔ᮪ᮌ᮪ᮊᮨᮅᮔ᮪ ᮘᮞᮔ ᮠᮔ᮪ᮒᮨᮅ, ᮞᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮥᮔᮤ ᮒᮥ ᮊᮥ ᮃᮔᮊ᮪ ᮊᮥ éwé, ᮙᮥᮜᮠ᮪ ᮓᮨᮊ᮪ ᮊᮕᮜᮤᮊᮨᮒᮔ᮪. ᮞᮥᮌᮔ᮪ ᮙᮧ ᮞᮕᮤᮒ᮪wᮃᮠᮨᮅᮔ᮪, ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮙ ᮘᮨᮅᮔᮔ᮪ᮌ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮡᮛᮙᮔ᮪, ᮒ᮪éᮊ ᮔᮥᮛᮥᮒ᮪ᮔ ᮕᮔᮡᮛᮙᮔ᮪, ᮔ ᮕᮙᮌᮠᮔ᮪</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hendaknya kita tidur sekadar penghilang kantuk, minum tuak sekadar penghilang haus, makan sekadar penghilang lapar, janganlah terlalu berlebihlebihan. Ingatlah ketika kita tidak (memiliki apa-apa). Demikian pula dengan anak-isteri, jangan bersikap pembeli hati. Supaya tidak hanya tampaknya saja berbuat. Bila kita berhasil mengajarinya, itulah yang menuruti nasihat dan petuah.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jaga urang héés tamba tunduh, nginum tuak tamba hanaang, nyatu tamba ponyo, ulah kajongjongan teuing. tineungkeun basana hanteu, sang nguni tu ku anak ku éwé, mulah dek kapaliketan. sugan mo sapitwaheun, rampés ma beunang urang nyaraman, téka nurutna panyaraman, na pamagahan</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_30"/>
        <lempirNaskah><![CDATA[<A.17v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-29</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ratu">
    <kataSunda>ratu</kataSunda>
    <aksaraKata>ᮛᮒᮥ</aksaraKata>
    <artiIndonesia>raja</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_13">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮓᮜᮨᮙ᮪, ᮊᮔ᮪ᮓᮔ᮪ᮌ᮪ ᮜᮛᮔ᮪ᮌ᮪, ᮘᮜ᮪é ᮜᮛᮔ᮪ᮌᮔ᮪. ᮙᮊ ᮔ᮪ᮌᮥᮔᮤ ᮔ᮪ᮌᮜᮔ᮪ᮌ᮪ᮞᮤᮔᮔ᮪ᮌ᮪, ᮙᮕᮌ᮪ ᮔ᮪ᮌᮜᮤwᮃᮒ᮪ ᮛᮒᮥ, ᮙcᮃᮔ᮪ᮌ᮪ᮊᮢᮙ, ᮊ᮪éᮔ ᮔ ᮄᮒᮥ ᮕᮛᮔ᮪ᮒᮤ ᮃᮞᮥᮕ᮪ ᮓᮜᮨᮙ᮪, ᮙᮔ᮪ᮌ᮪ᮊ ᮛ᮪éᮃ ᮜᮤᮈᮅᮊ᮪, ᮞᮥᮌᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮛᮥᮙ᮪ᮕᮊ᮪, ᮔᮨᮘᮥᮊ᮪, ᮙᮨᮌᮒ᮪ ᮏᮏᮛᮔ᮪. ᮏᮌ ᮅᮛᮔ᮪ᮌ᮪ ᮓᮤᮅᮊ᮪, ᮅᮜᮠ᮪ ᮞᮜᮠ᮪ ᮠᮛᮨᮅᮕ᮪, ᮙᮊ ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮔ ᮓᮤᮞᮤᮜ, ᮓᮨᮅᮔ᮪ᮌ᮪ ᮞᮥᮌᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮓᮤᮘᮔ᮪ ᮜ᮪éᮙ᮪éᮊ᮪ ᮊᮥ ᮒᮧᮠᮔ᮪, ᮒᮤᮔᮨᮅᮔ᮪ᮌ᮪ᮊᮨᮅᮔ᮪ ᮔ ᮕᮤcᮃᮁéᮊᮨᮅᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪. ᮃᮞᮤᮔ᮪ᮌ᮪ ᮞᮤᮈᮅᮕ᮪ ᮙ ᮞᮙᮕᮥᮔ᮪, ᮒᮤᮠᮕ᮪ ᮞᮥᮊᮔ ᮒᮧᮠᮔ᮪.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">di dalam keraton, kandang larangan, rumah larangan, Demikian pula memintas jalan, menghampiri atau melewati rombongan raja yang sedang macangkrama, karena semua itu masuk ke dalem keraton, maka seringlah menengok, kita melanggar, mendorong memutus jajaran (orang-orang yang sedang duduk), Jangan salah menghadap (ketika duduk), baik-baiklah duduk bersila, dan sekiranya kita diajak bicara oleh raja, pikirkanlah betul-betul bicara kita, Harus layak dan baik supaya menyenangkan raja</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dalem, kandang larang, balé larangan. maka nguni ngalangsinang, mapag ngaliwat ratu, macangkrama, kéna na itu paranti asup dalem, mangka réa lieuk, sugan urang ngarumpak, nebuk, megat jajaran. jaga urang diuk, ulah salah hareup, maka rampés na disila, deung sugan urang dibaan lémék ku tohaan, tineungkeun na picarékeun urang. asing sieup ma samapun, tihap sukana tohaan.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_14"/>
        <lempirNaskah><![CDATA[<A.2v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-13</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_hayu">
    <kataSunda>hayu</kataSunda>
    <aksaraKata>ᮠᮚᮥ</aksaraKata>
    <artiIndonesia>kebahagiaan; kebaikan; selamat</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianPembuka rdf:about="http://contoh.org/ontology#skk_baris_01">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮔ᮪ᮓᮠ᮪ ᮔᮤᮠᮔ᮪ wᮃᮛᮠᮊ᮪ᮔ ᮞᮔ᮪ᮌ᮪ ᮞᮓᮥ ᮓ᮪éᮔ᮪ ᮞᮔ᮪ᮌ᮪ ᮙᮙᨨ᮪ ᮠᮚᮥ, ᮚ ᮅᮏᮁ ᮞᮔ᮪ᮌ᮪ ᮞᮓᮥ, ᮔ᮪ᮌᮌᮨᮜᮁᮊᮨᮅᮔ᮪ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮞᮤᮊ᮪ᮞ ᮊᮔ᮪ᮓᮔ᮪ᮌ᮪ ᮊᮛᮨᮞᮤᮃᮔ᮪.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ya inilah bagi mereka yang mencari kebahagiaan Ada ajaran kebaikan ujar sang budiman memaparkan Sang Hyang Siksa Kandang Karesian</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ndah nihan warahakna sang sadu dén sang mamet hayu, ya ujar sang sadu, ngagelarkeun sang hyang siksa kandang karesian.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_02"/>
        <lempirNaskah><![CDATA[<B.1r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-01</dcterms:identifier>
      </BagianPembuka>
    </munculDi>
    <terkaitKonsep>
      <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_kebaikan">
        <rdfs:label>kebaikan</rdfs:label>
        <hasSynonym rdf:resource="http://contoh.org/ontology#konsep_kebajikan"/>
      </KonsepKamus>
    </terkaitKonsep>
  </EntriLeksikal>
  <owl:DatatypeProperty rdf:about="http://contoh.org/ontology#kelasKata">
    <rdfs:label xml:lang="id">Kelas Kata</rdfs:label>
    <rdfs:comment xml:lang="id">Kategori gramatikal kata (nomina, verba, adjektiva, dll.).</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_silih">
    <kataSunda>silih</kataSunda>
    <aksaraKata>ᮞᮤᮜᮤᮂ</aksaraKata>
    <artiIndonesia>saling</artiIndonesia>
    <kelasKata>adverbia</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_06">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮙᮥᮜᮠ᮪ ᮞᮤᮜᮤᮠ᮪ ᮞᮨᮓᮨᮊ᮪ ᮞᮤᮜᮤᮠ᮪ ᮎᮥᮛᮤᮌ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janganlah saling mendesak, saling mencurigai.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mulah silih sedek silih curiga.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_07"/>
        <lempirNaskah><![CDATA[<L.2r>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-06</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_hyang">
    <kataSunda>hyang</kataSunda>
    <aksaraKata>ᮠᮡᮀ</aksaraKata>
    <artiIndonesia>yang suci; dewa</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_11">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮊᮥ ᮛᮙ ᮊᮥ ᮕᮔ᮪ᮌᮥᮛᮔ᮪ᮌ᮪, ᮓᮞ cᮃᮜᮌᮛ, ᮅᮕᮨᮒᮤ, ᮕᮔ᮪ᮌ᮪ᮌᮨᮛᮨᮞ᮪ ᮛᮨᮅᮙ, ᮙᮔ᮪ᮌ᮪ᮊ ᮞᮥᮊ ᮌᮨᮅᮄᮔ᮪ᮌ᮪ ᮅᮛᮔ᮪ᮌ᮪, ᮙᮊ ᮃᮞ ᮊᮓᮒᮔ᮪ᮌᮔ᮪ ᮊᮥ ᮊᮥᮜᮥᮊᮓᮔ᮪ᮌ᮪ ᮘᮛᮚ, ᮊᮥ ᮃᮓᮤ ᮊᮥ ᮜᮔ᮪cᮈᮅᮊ᮪, ᮊᮥ ᮃᮔᮊ᮪ ᮙᮤᮒᮢ ᮞᮥᮃᮔ᮪ ᮊᮕᮧᮔᮊᮔ᮪. ᮞᮊᮤᮒᮥ éᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ᮔ, ᮔ᮪ᮌᮔ᮪ ᮜᮙᮥᮔ᮪ ᮃᮚ ᮕᮔ᮪ᮌᮒ᮪ ᮅᮛᮔ᮪ᮌ᮪, ᮊᮤcᮃᮕ᮪ ᮄᮔᮥᮙ᮪, ᮞᮤᮙ᮪ᮘᮥᮒ᮪ cᮃwᮈᮒ᮪, ᮞᮥᮊ ᮓᮢᮨᮘᮡ. ᮙᮔ᮪ᮌ᮪ᮊ ᮛᮞ ᮕᮥᮏ ᮔᮡᮔ᮪ᮌ᮪ᮌᮢᮠ, ᮊ ᮠᮡᮔ᮪ᮌ᮪ ᮊ ᮓ᮪éwᮃᮒ. ᮃᮔ᮪ᮌ᮪ᮌᮨᮅᮞ᮪ ᮙ ᮏᮌ ᮅᮛᮔ᮪ᮌ᮪ ᮓᮤᮌᮥᮔᮊᮨᮅᮔ᮪, ᮊ ᮌᮌ ᮊ ᮞwᮃᮠ᮪ ᮊ ᮞ᮪éᮛᮔ᮪ᮌ᮪ ᮃᮌᮨᮅᮔ᮪ᮌ᮪, ᮔ᮪ᮌᮤᮊᮤᮞ᮪, ᮙᮛᮤᮌᮤ, ᮔ᮪ᮌᮔ᮪ᮓᮔ᮪ᮌ᮪, ᮔ᮪ᮌ , ᮙᮛᮊ᮪, ᮙᮥᮔ᮪ᮓᮚ᮪, ᮔ᮪ᮌᮓᮧᮌ᮪éᮛ᮪, ᮙᮔ᮪ᮌ᮪ᮕᮚᮔ᮪ᮌ᮪, ᮔᮡᮄᮁ ᮘᮤᮔ᮪cᮃᮔ᮪ᮌ᮪, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮌᮥᮔ ᮒᮧᮠᮔ᮪, ᮅᮜᮠ᮪ ᮞᮥᮔ᮪ᮌ᮪ᮞᮥᮒ᮪, ᮅᮜᮠ᮪ ᮞᮥᮛᮠ᮪, ᮅᮜᮠ᮪ ᮕᮥᮛᮤᮊ᮪, ᮓᮨᮅᮔ᮪ᮌ᮪ ᮌᮛᮤᮔ᮪ᮌ᮪ᮞᮤᮔ᮪ᮌ᮪, ᮕᮠᮤ ᮞᮥᮊ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oleh rama, pangurang, dasa calagara, upeti, panggeres reuma, maka berbahagialah dalam tindakan kita, anggaplah seperti didatangi oleh kerabat keluarga, adik, kakak, anak, sahabat, suan atau keponakan. Demikianlah ibaratnya. Namun bila ada pengertian kita kepada mereka, maka sediakanlah makanan, minuman, selimut, kain cawat dengan suka hati. Resapkanlah puja dan berlindung kepada hyang dan dewata. Jika kita diperintah bekerja ke ladang, ke sawah, ke sérang besar, mengukuhkan tepian sungai, menggali saluran, mengandangkan ternak. membendung sebagian jalur sungai untuk menangkap ikan, menjala, menarik jaring, memasang jaring, menangguk ikan, merentang jaring, segala pekerjaan untuk kepentingan raja, jangan marah-marah, jangan munafik, jangan resah dan uring-uringan, kerjakanlah dengan senang hati</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ku rama ku pangurang, dasa calagara, upeti, panggeres reuma, mangka suka geuing urang, maka asa kadatangan ku kulukadang baraya, ku adi ku lanceuk, ku anak mitra suan kaponakan. sakitu éta kangkenna, ngan lamun aya panghaat urang, kicap inum, simbut cawet, suka drebya. mangka rasa puja nyanggraha, ka hyang ka déwata. anggeus ma jaga urang digunakeun, ka gaga ka sawah ka sérang ageung, ngikis, marigi, ngandang, nga , marak, munday, ngadogér, mangpayang, nyair bincang, sing sawatek guna tohaan, ulah sungsut, ulah surah, ulah purik, deung garingsing, pahi suka</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_12"/>
        <lempirNaskah><![CDATA[<A.1r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-11</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_watang">
    <kataSunda>watang</kataSunda>
    <aksaraKata>ᮝᮒᮀ</aksaraKata>
    <artiIndonesia>batang pohon</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_04">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮔ ᮒᮥᮍ᮪ᮌᮊ᮪ ᮠᮔ ᮝᮒ᮪ᮍ᮪, ᮒᮔ᮪ ᮠᮔ ᮒᮥᮍ᮪ᮌᮊ᮪ ᮒᮔ᮪ ᮠᮔ ᮝᮒ᮪ᮍ᮪.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ada tunggul pohon ada batang pohon, tidak ada tunggul tidak ada batang.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hana tunggak hana watang, tan hana tunggak tan hana watang.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_05"/>
        <lempirNaskah><![CDATA[<L.1v>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-04</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_kreta">
    <kataSunda>kreta</kataSunda>
    <aksaraKata>ᮊᮢᮨᮒ</aksaraKata>
    <artiIndonesia>sejahtera; tata tentram</artiIndonesia>
    <kelasKata>adjektiva</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_02">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮄᮔᮤ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ ᮊᮥᮔ᮪ᮓᮔ᮪ᮌᮨᮅᮔ᮪ ᮔ ᮅᮛᮔ᮪ᮌ᮪ ᮛ᮪éᮚ ᮓᮤ ᮔ ᮘ᮪wᮃᮔ ᮕᮥᮔ᮪. ᮕᮊᨨ᮪ ᮠᨨᮥᮘᨨ᮪ ᮠᮥᮛᮤᮕ᮪, ᮠᨨᮥᮘᨨ᮪ ᮔ ᮅᮛᮔ᮪ᮌ᮪ ᮛ᮪éᮚ.  ᮄᮔᮤ ᮘᮤᮚᮊ᮪ᮒᮔ, ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ ᮊᮢᮨᮒ ᮔ᮪ᮌᮛᮔᮤᮚ, ᮊᮜᮔ᮪ᮊᮔ᮪ᮌ᮪ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inilah sanghiyang dasa sebagai pegangan orang banyak di dunia. Agar senantiasa sejahtera lama bagi orang banyak. Inilah buktinya, sang hyang dasa kreta namanya, Bayang-bayang dasa</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ini sang hyang dasa kundangeun na urang réya di na bwana pun. pakeun heubeul hurip, heubeul na urang réya.  ini biyaktana, sang hyang dasa kreta ngaraniya, kalangkang sang hyang dasa</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_03"/>
        <lempirNaskah><![CDATA[<B.1r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-02</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
    <terkaitKonsep>
      <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_sejahtera">
        <rdfs:label>sejahtera</rdfs:label>
      </KonsepKamus>
    </terkaitKonsep>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_hees">
    <kataSunda>héés</kataSunda>
    <aksaraKata>ᮠᮦᮆᮞ᮪</aksaraKata>
    <artiIndonesia>tidur</artiIndonesia>
    <kelasKata>verba</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_29"/>
  </EntriLeksikal>
  <BagianPembuka rdf:about="http://contoh.org/ontology#ag_baris_01">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮃᮝᮤᮌ᮪ᮔᮙ᮪ ᮃᮞ᮪ᮒᮥ. ᮔᮤᮠᮔ᮪ ᮒᮨᮙ᮪ᮘᮨᮚ᮪ ᮞᮊᮊᮜ ᮛᮠᮡᮀ ᮘᮍ, ᮙᮞ ᮞᮡ ᮔ᮪ᮌᮥᮞᮥᮊ᮪ ᮔ ᮕᮊ᮪ᮝᮔ᮪ ᮙᮊᮍᮛᮔ᮪ ᮛᮠᮡᮀᮒ ᮝᮥᮝᮥᮞ᮪.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semoga selamat. Inilah permulaan tanda peringatan Rahyang Banga, ketika ia membuat parit (pertahanan) Pakuan, bernama Rahyangta Wuwus.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">awignam astu. nihan tembey sakakala rahyang banga, masa sya nyusuk na pakwan makangaran rahyangta wuwus.</hasTransliteration>
    <isFromManuscript>
      <Manuskrip rdf:about="http://contoh.org/ontology#amanatGalunggung">
        <dcterms:creator>Rakeyan Darmasiksa</dcterms:creator>
        <dcterms:language>su</dcterms:language>
        <dcterms:title>Amanat Galunggung</dcterms:title>
      </Manuskrip>
    </isFromManuscript>
    <lanjutKeBaris>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_02">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮔ ᮍᮥᮔᮤ ᮠᮔ ᮙᮀᮊᮦ, ᮒᮔ᮪ ᮠᮔ ᮍᮥᮔᮤ ᮒᮔ᮪ ᮠᮔ ᮙᮀᮊᮦ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ada masa lalu ada masa kini, tidak ada masa lalu tidak ada masa kini.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hana nguni hana mangke, tan hana nguni tan hana mangke.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_03"/>
        <lempirNaskah><![CDATA[<L.1r>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-02</dcterms:identifier>
      </BagianAjaranMoral>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<L.1r>]]></lempirNaskah>
    <dcterms:identifier>AG-BARIS-01</dcterms:identifier>
  </BagianPembuka>
  <owl:ObjectProperty rdf:about="http://contoh.org/ontology#munculDi">
    <rdfs:label xml:lang="id">Muncul Di Baris</rdfs:label>
    <rdfs:comment xml:lang="id">Menghubungkan entri kata dengan baris naskah tempat kata tersebut muncul.</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
    <rdfs:range rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://contoh.org/ontology#mengandungKata">
        <rdfs:label xml:lang="id">Mengandung Kata</rdfs:label>
        <rdfs:comment xml:lang="id">Kebalikan dari :munculDi; baris naskah mengandung entri kata.</rdfs:comment>
        <rdfs:domain rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
        <rdfs:range rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_bangbara">
    <kataSunda>bangbara</kataSunda>
    <aksaraKata>ᮘᮀᮘᮛ</aksaraKata>
    <artiIndonesia>kumbang</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_36">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮚᮔ᮪ᮌ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮛᮥᮙ᮪ ᮃᮙᮤᮞ᮪ ᮔᮤᮔ᮪ᮌ᮪ ᮊᮨᮙ᮪ᮘᮔ᮪ᮌ᮪ ᮙ ᮘᮔ᮪ᮌ᮪ᮘᮛ ᮒᮔᮡ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ingin tahu tentang harum dan manisnya bunga, tanyalah kumbang</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hayang nyaho di ruum amis ning kembang ma bangbara tanya.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_37"/>
        <lempirNaskah><![CDATA[<A.8r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-36</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_kasukan">
    <kataSunda>kasukan</kataSunda>
    <aksaraKata>ᮊᮞᮥᮊᮔ᮪</aksaraKata>
    <artiIndonesia>kebahagiaan; kesenangan</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_25">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮜᮙᮥᮔ᮪ ᮙᮊ ᮞᮥᮊ ᮒᮤ ᮔᮥ ᮞᮅᮛᮔ᮪ᮌ᮪, ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮕᮁé ᮘᮨᮅᮛᮒ᮪ ᮞᮔ᮪ᮌ᮪ᮌ ᮒ, ᮘᮧᮃ ᮙᮊ ᮠᮥᮛᮤᮕ᮪ ᮔ ᮅᮛᮔ᮪ᮌ᮪ ᮛ᮪éᮃ, ᮏ ᮊᮒᮨᮙᮥ ᮔ wwᮄᮒ᮪ ᮞᮥᮊ ᮜwᮃᮔ᮪ éᮔᮊ᮪, ᮞᮔ᮪ᮌ᮪ᮊᮤᮜᮔ᮪ᮌ᮪ ᮔᮥ ᮔ᮪ᮌᮥᮕᮒ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮞᮜᮠ᮪ ᮃᮜ ᮕᮔᮡᮛᮙᮔ᮪. ᮃᮚ ᮒ᮪wᮃᮠ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮈᮅᮛᮨᮅᮔᮔ᮪, ᮠᮔ᮪ᮒᮨᮅ ᮒ᮪wᮃᮠ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮃᮜ ᮃ ᮌᮥᮛᮥᮃᮔ᮪ ᮔ᮪é ᮏᮔ᮪ᮙ ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮚ ᮞᮤᮔᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮕᮛᮙᮛᮨᮒ wᮄᮞ᮪éᮞ ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮓ᮪éwᮃ ᮙᮔ᮪ᮌ᮪ᮏᮔ᮪ᮙ ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮚ ᮞᮔ᮪ᮌ᮪ ᮕᮥᮁᮔ ᮞᮛᮤᮛ, ᮚ wwᮃᮒ᮪ ᮔ ᮠᮚᮥ, ᮚ ᮕ ᮘᮨᮔᮨᮁ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila merasa bahagia dari seseorang itu ibarat padi berat isi pasti sejahteralah orang banyak karena bertemu dengan sumber kesenangan dan kenikmatan, meskipun orang yang mengumpat kita menyalahi nasihat. Bila sedang sibuk tundalah sementara tidaklah pekerjaan kita manusia namanya itu bagaikan purna sarira (keutamaan tertinggi) itulah benih kebajikan dan kebenaran</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lamun maka suka ti nu saurang, kangken paré beurat sangga ta, boa maka hurip na urang réa, ja katemu na wwit suka lawan énak, sangkilang nu ngupat urang salah ala panyaraman. aya twah urang eureunan, hanteu twah urang ala a guruan né janma ngaranna, ya sinangguh paramareta wisésa ngaranna, ya kangken déwa mangjanma ngaranna, ya sang purna sarira, ya wwat na hayu, ya pa bener.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_26"/>
        <lempirNaskah><![CDATA[<A.16v:1>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-25</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
    <terkaitKonsep>
      <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_bahagia">
        <rdfs:label>kebahagiaan</rdfs:label>
        <hasSynonym rdf:resource="http://contoh.org/ontology#konsep_sejahtera"/>
      </KonsepKamus>
    </terkaitKonsep>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_tunggak">
    <kataSunda>tunggak</kataSunda>
    <aksaraKata>ᮒᮥᮀᮌᮊ᮪</aksaraKata>
    <artiIndonesia>tunggul pohon</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#ag_baris_04"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ewe">
    <kataSunda>éwé</kataSunda>
    <aksaraKata>ᮆᮝᮦ</aksaraKata>
    <artiIndonesia>istri; perempuan</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_28">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮊᮊᮥᮛᮔ᮪ᮌᮔ᮪, ᮃᮔᮊ᮪ éwé ᮕᮤᮒᮥᮒᮥᮛᮔ᮪, ᮞᮥᮌᮔ᮪ ᮊᮨᮅᮔ ᮊᮥ ᮔ ᮌᮥᮛᮥ ᮘᮜ ᮞᮤᮊ᮪ᮞ. ᮄᮚᮒ᮪ᮔᮊᮨᮅᮔ᮪ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮞᮤᮊ᮪ᮞ ᮊᮔ᮪ᮓᮔ᮪ᮌ᮪ ᮊᮛᮨᮞᮡᮔ᮪.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kekurangan; anak dan isteri diberi nasihat agar tidak dikatakan merusak kesusilaan. Perhatikanlah Sanghyang Siksa Kandang Karesian</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kakurangan, anak éwé pituturan, sugan keuna ku na guru bala siksa. iyatnakeun sang hyang siksa kandang karesyan.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_29"/>
        <lempirNaskah><![CDATA[<A.17v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-28</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <owl:Ontology rdf:about="http://contoh.org/ontology#">
    <rdfs:label xml:lang="id">Ontologi Naskah Sunda Kuno Siksa Kandang Karesian</rdfs:label>
    <dcterms:creator xml:lang="id">Stan Fredheric, Miftah Rijallul Aziz, Fawwaz Areefa Yaqzhan</dcterms:creator>
    <dcterms:title xml:lang="id">Ontologi Sunda Kuno</dcterms:title>
    <rdfs:comment xml:lang="id">Ontologi ini dirancang untuk merepresentasikan struktur, konten, hubungan semantik, dan kamus sinonim dari naskah kuno Sunda Siksa Kandang Karesian.</rdfs:comment>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="http://contoh.org/ontology#aksaraKata">
    <rdfs:label xml:lang="id">Bentuk Aksara Sunda</rdfs:label>
    <rdfs:comment xml:lang="id">Bentuk tulisan kata dalam Aksara Sunda Baku (alih aksara dari transliterasi Latin sesuai kaidah rarangkén Unicode).</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_sawah">
    <kataSunda>sawah</kataSunda>
    <aksaraKata>ᮞᮝᮂ</aksaraKata>
    <artiIndonesia>sawah</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_11"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_guru">
    <kataSunda>guru</kataSunda>
    <aksaraKata>ᮌᮥᮛᮥ</aksaraKata>
    <artiIndonesia>guru</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_18">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮊᮤᮒᮥ ᮊ᮪éᮠ᮪ᮔ ᮄᮔ᮪ᮌᮨᮒ᮪ᮊᮨᮅᮔᮨᮅᮔ᮪, ᮠᮜ ᮠᮚᮥ ᮌᮧᮁéᮔ᮪ᮌ᮪ ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮃᮜ ᮕᮌᮥᮁwᮃᮔ᮪. ᮄᮔᮤ ᮕᮔ᮪ᮌᮤᮔ᮪ᮌᮨᮒ᮪ ᮃᮚ ᮙ ᮔ ᮏᮔ᮪ᮙ ᮕéᮠ᮪ ᮙᮜᮤᮔ᮪ᮌ᮪, ᮕéᮠ᮪ ᮕᮕᮔ᮪ᮏᮤᮔ᮪ᮌᮔ᮪, ᮕéᮠ᮪ ᮔᮕᮥ, ᮕéᮠ᮪ ᮔ᮪ᮌᮘ᮪éᮌᮜ᮪, ᮕéᮠ᮪ ᮙ᮪éᮇᮁ, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ cᮈᮊᮕ᮪ cᮃᮛᮥᮒ᮪, éᮒ ᮊ᮪éᮠ᮪ ᮏᮨᮅᮈᮅᮔ᮪ᮌ᮪ ᮅᮜᮠ᮪ ᮓᮤᮒᮥᮛᮥᮒᮔ᮪. ᮏ éᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮔᮤᮞ᮪ᮒ ᮔ᮪ᮌᮛᮔ᮪ᮔ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Itu semua patut diingat, sengsara dan bahagia, buruk dan baik, tergantung kepada gurunya, Ini sebagai pengingat ada orang yang mati waktu mencuri, mati ketika menggerayangi rumah orang, mati ketika napu, mati waktu menodong, mati waktu merangkum, segala macam perbuatan hianat, itu semua harus diperhatikan jangan diikuti. Karena itulah yang disebut guru nista namanya</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kitu kéhna ingetkeuneun, hala hayu goréng rampés ala pagurwan. ini panginget aya ma na janma paéh maling, paéh papanjingan, paéh napu, paéh ngabégal, paéh méor, sing sawatek cekap carut, éta kéh jeueung ulah diturutan. ja éta kangken guru nista ngaranna.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_19"/>
        <lempirNaskah><![CDATA[<A.3v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-18</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <owl:DatatypeProperty rdf:about="http://contoh.org/ontology#hasTransliteration">
