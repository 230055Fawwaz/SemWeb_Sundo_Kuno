  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ngaran">
    <kataSunda>ngaran</kataSunda>
    <aksaraKata>ᮍᮛᮔ᮪</aksaraKata>
    <artiIndonesia>nama</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_08">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮕᮔ᮪ᮌᮣᮥᮔ᮪ᮌ᮪ᮌᮥᮠᮔ᮪ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮕᮒᮔ᮪ᮏᮨᮅᮁ ᮒᮔ᮪ᮏᮨᮅᮁ, ᮓᮤ ᮕᮤᮕᮤᮁ ᮓᮤ ᮘᮥᮛᮥᮃᮔ᮪, ᮕᮒᮥᮒᮥᮔ᮪ᮌ᮪ᮌᮜᮔ᮪, ᮙᮊ ᮔ᮪ᮌᮥᮔᮤ ᮔᮨᮘᮥ ᮠᮚᮥ ᮄ ᮊᮜᮤᮠ᮪ ᮔ᮪ᮌwᮄᮠ᮪ ᮚ ᮜᮨᮙ᮪ᮘᮥ ᮃᮔ᮪ᮌ᮪ᮌᮜᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮔᮡᮔ᮪ᮓ ᮓᮤ ᮅᮛᮥᮒ᮪ ᮃᮔ᮪ᮌ᮪ᮌᮞᮤᮔ᮪, ᮄᮒᮥ ᮊᮨᮠ᮪ᮔ ᮄᮔ᮪ᮌᮨᮒ᮪ᮊᮨᮅᮔᮨᮅᮔ᮪ᮔ, ᮜᮙᮥᮔ᮪ ᮓ᮪éᮊ᮪ ᮜᮥᮕᮥᮒ᮪ éᮞ᮪ᮒᮢᮤ ᮜᮛᮔ᮪ᮌᮔ᮪ ᮞᮊᮜᮤᮠ᮪, ᮔ᮪ᮌᮛᮔ᮪ᮔ ᮊᮨᮘᮧ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">di tempat duduk namanya, Berdiri di pinggir rumah atau di halaman hanya berduaan demi- kian pula menyahut ibu-ibu yang melantunkan kawih itu lembu anggalang namanya Bersandar pada bekas anggasin Itu semua untuk diingat jika ingin terhindar wanita larangan dinamakan kebo sapitunahan</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">panglungguhan ngaranna. patanjeur tanjeur, di pipir di buruan, patutunggalan, maka nguni nebu hayu i kalih ngawih ya lembu anggalang ngaranna, nyanda di urut anggasin, itu kehna ingetkeuneunna, lamun dék luput éstri larangan sakalih, ngaranna kebo</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_09"/>
        <lempirNaskah><![CDATA[<B.2r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-08</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ulah">
    <kataSunda>ulah</kataSunda>
    <aksaraKata>ᮅᮜᮂ</aksaraKata>
    <artiIndonesia>jangan</artiIndonesia>
    <kelasKata>partikel</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_05"/>
  </EntriLeksikal>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_16">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮃᮚ ᮙ ᮏᮔ᮪ᮙ ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮛ᮪wᮃᮔ, ᮌᮧᮁéᮔ᮪ᮌ᮪ ᮒ᮪wᮃᮠ᮪ᮔ, ᮄᮛᮨᮌ᮪ ᮒᮤᮔ᮪ᮌ᮪ᮊᮠ᮪ᮔ, ᮄᮒᮥ ᮏᮨᮅᮏᮨᮅᮈᮅᮔ᮪ᮌ᮪ ᮓᮤᮒᮥᮛᮥᮒ᮪ ᮒᮤᮔ᮪ᮌ᮪ᮊᮠ᮪ᮔ, ᮒᮥᮛᮥᮒ᮪ ᮛ᮪wᮃᮔ. ᮃᮚ ᮔ ᮏᮔ᮪ᮙ ᮌᮧᮁéᮔ᮪ᮌ᮪ ᮛ᮪wᮃᮔ ᮛᮙ᮪ᮕ᮪éᮞ᮪</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ada orang baik penampilannya, buruk perbuatannya, buruk tingkahnya, maka perhatikanlah tingkahnya itu, tirulah penampilannya. Bila ada orang yang buruk penampilannya, tetapi baik</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aya ma janma rampés rwana, goréng twahna, ireg tingkahna, itu jeujeueung diturut tingkahna, turut rwana. aya na janma goréng rwana rampés</hasTransliteration>
    <isFromManuscript>
      <Manuskrip rdf:about="http://contoh.org/ontology#siksaKandangKaresian">
        <dcterms:creator>Anonim</dcterms:creator>
        <dcterms:language>su</dcterms:language>
        <dcterms:title>Siksa Kandang Karesian</dcterms:title>
      </Manuskrip>
    </isFromManuscript>
    <lanjutKeBaris>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_17">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮒ᮪wᮃᮠ᮪ᮔ, ᮄᮒᮥ ᮙ ᮅᮜᮠ᮪ ᮓᮤᮒᮥᮛᮥᮒ᮪ ᮒᮤᮔ᮪ᮌ᮪ᮊᮠ᮪ᮔ, ᮓᮛ ᮞᮧᮊ᮪ ᮏᮨᮅᮈᮅᮔ᮪ᮌ᮪ ᮛ᮪wᮃᮔ, ᮒᮥᮛᮥᮒ᮪ ᮒ᮪wᮃᮠ᮪ᮔ. ᮃᮚ ᮙ ᮏᮔ᮪ᮙ ᮌᮧᮁéᮔ᮪ᮌ᮪ ᮛ᮪wᮃᮔ, ᮄᮛᮨᮌ᮪ ᮒᮤᮔ᮪ᮌ᮪ᮊᮠ᮪ᮔ, ᮌᮧᮁéᮔ᮪ᮌ᮪ ᮒ᮪wᮃᮠ᮪ᮔ, ᮄᮒᮥ ᮙ cᮃᮛᮥᮒ᮪ ᮔᮤᮔ᮪ᮌ᮪ ᮘᮥᮙᮤ, ᮞᮤᮜᮤᮠ᮪ ᮓᮤᮛᮤ ᮔ ᮅᮛᮔ᮪ᮌ᮪ ᮞᮘ᮪wᮃᮔ, ᮔ᮪ᮌᮛᮔ᮪ᮔ cᮃᮜᮔᮤᮔ᮪ᮌ᮪ ᮏᮔ᮪ᮙ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perbuatannya, yang demikian itu jangan ditiru tingkahnya, jangan perhatikan penampilannya, tirulah perbuatannya Bila ada orang yang buruk, penampilannya, pandir tingkahnya dan buruk pula perbuatannya, yang demikian itu noda di dunia, dirinya menjadi pengganti (tumbal) kita sedunia, namanya kebusukan manusia</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">twahna, itu ma ulah diturut tingkahna, dara sok jeueung rwana, turut twahna. aya ma janma goréng rwana, ireg tingkahna, goréng twahna, itu ma carut ning bumi, silih diri na urang sabwana, ngaranna calaning janma.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_18"/>
        <lempirNaskah><![CDATA[<A.3v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-17</dcterms:identifier>
      </BagianAjaranMoral>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<A.3r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-16</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#ag_baris_10">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮏᮌ ᮝᮛᮞ᮪ ᮊᮘᮥᮚᮥᮒ᮪ᮔ ᮕᮊᮨᮥᮔ᮪ ᮎᮡᮀ ᮏᮜᮔ᮪.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jagalah agar kabuyutan tetap selamat agar jalan menjadi terang.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jaga waras kabuyutna pakeun caang jalan.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
    <lempirNaskah><![CDATA[<L.3r>]]></lempirNaskah>
    <dcterms:identifier>AG-BARIS-10</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_09">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮞᮕᮤᮒᮥᮔᮠᮔ᮪, ᮄᮔᮡ</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Itulah</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sapitunahan, inya</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_10">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮄᮔ᮪ᮌᮨᮒ᮪ᮊᮨᮅᮔᮨᮅᮔ᮪, ᮞᮤᮔᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮅᮜᮠ᮪ ᮕᮙᮜᮤ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮊᮤᮒᮥ ᮊ᮪éᮠ᮪ ᮜᮙᮥᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮓ᮪éᮊ᮪ ᮕᮕᮛᮔ᮪ ᮅᮜᮠ᮪ ᮓ᮪éᮊ᮪ ᮊᮒᮥᮛᮥᮒ᮪ ᮊᮥ ᮠᮥᮜᮥᮔ᮪ ᮞᮊᮜᮤᮠ᮪. ᮜᮙᮥᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮓ᮪éᮊ᮪ ᮙᮔ᮪ ᮄᮔᮡ ᮙ, ᮙᮔ᮪ᮌ᮪ᮊ ᮙᮏᮁ ᮊ ᮕᮔ᮪ᮌᮥᮜᮥ ᮒᮔ᮪ᮓᮔ᮪ᮌ᮪ᮔ. ᮜᮙᮥᮔ᮪ᮔ ᮊᮕᮤcᮃᮚ ᮙ ᮞᮙᮚᮊᮨᮅᮔ᮪, ᮊᮥ ᮌᮨᮛᮤᮔ᮪ᮌ᮪ᮔ, ᮊᮥ ᮕéᮠ᮪ᮔ, ᮊᮥ ᮜᮨᮅᮔ᮪ᮌᮤᮒ᮪ᮔ, ᮕᮧᮛᮧᮔ᮪ ᮙᮒᮤ ᮞᮁéᮃᮔ, éᮒ ᮙ ᮘᮔ᮪. ᮠᮙᮧ ᮒᮥ ᮃᮚ ᮔ ᮕᮤᮓᮧᮞᮈᮅᮔ᮪, ᮊ᮪éᮔ ᮊᮧᮜᮧᮒ᮪ᮔ ᮞᮙᮚ ᮙᮔᮔ᮪ᮔ ᮃᮌᮙ. ᮠᮙᮧ ᮙ ᮓᮤᮕᮤcᮃᮚ, ᮅᮜᮠ᮪, ᮜᮙᮥᮔ᮪ ᮊᮨᮅᮓᮨᮅ ᮙ ᮓ᮪éᮊ᮪ ᮙᮔ᮪ ᮄᮔᮡ, ᮕéᮠ᮪ ᮜᮨᮅᮔ᮪ᮌᮤᮒ᮪ ᮔ᮪ᮌᮌᮔ᮪ᮒᮤᮃᮔ᮪ ᮞᮊᮓᮨᮓᮨᮌ᮪ᮔ, ᮞᮙᮔ᮪ᮌ᮪ᮊᮔ᮪ᮔ ᮊᮔ᮪ ᮚᮒ᮪ᮔᮊᮨᮅᮔ᮪ ᮚᮒ᮪ᮔ ᮔᮤᮠᮔ᮪ ᮙwᮃᮠ᮪ ᮏᮌ ᮊᮓᮒᮔ᮪ᮌᮔ᮪ ᮊᮥ ᮙ᮪éᮔᮊ᮪ ᮞᮌᮥᮔ᮪ᮌ᮪</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">untuk diingat disebut perbuatan pemali namanya. Itu karena jika kita berkehendak janganlah sekali-kali ditiru oleh hulun semuanya. Jika kita hendak membawanya maka berbicaralah kepada penguasanya. Jika disetujui maka rundingkanlah perihal sakitnya, matinya, hilangnya, kuburannya semua, maka bawalah dia. Tidak akan menjadi sebuah dosa, karena orang tuanya taat kepada aturan agama. Jika tidak disetujui, jangan jalau bersikeras hendak membawa dia, bila mati atau hilang maka harus mengganti sendiri menurut kemampuan. karena itu berhati-hatilah, Ini lagi, jika suatu saat kita didatangi oleh semua petugas negara</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ingetkeuneun, sinangguh ulah pamali ngaranna. kitu kéh lamun urang dék paparan ulah dék katurut ku hulun sakalih. lamun urang dék maan inya ma, mangka majar ka panghulu tandangna. lamunna kapicaya ma samayakeun, ku geringna, ku paéhna, ku leungitna, poron mati saréana, éta ma baan. hamo tu aya na pidosaeun, kéna kolotna samaya mananna agama. hamo ma dipicaya, ulah, lamun keudeu ma dék maan inya, paéh leungit ngagantian sakadedegna, samangkanna kan yatnakeun yatna nihan mawah jaga kadatangan ku ménak sagung</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_11"/>
        <lempirNaskah><![CDATA[<A.1r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-10</dcterms:identifier>
      </BagianAjaranMoral>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<B.2r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-09</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_27">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮏᮌ ᮅᮛᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮏᮓᮤᮊᮨᮅᮔ᮪ ᮞwᮃᮠ᮪ ᮒᮤᮠᮕ᮪ ᮅᮜᮠ᮪ ᮞᮔ᮪ᮌ᮪ᮞᮛ. ᮏᮌ ᮛᮔ᮪ᮌ᮪ ᮔᮡᮤᮈᮅᮔ᮪ ᮊᮨᮘᮧᮔ᮪, ᮒᮤᮠᮕ᮪ ᮅᮜᮠ᮪ ᮔ᮪ᮌᮥᮔ᮪ᮓᮨᮅᮁ ᮊ ᮠᮥᮙ ᮘ᮪ééᮒ᮪ ᮞᮊᮜᮤᮠ᮪, ᮊ ᮠᮥᮙ ᮜᮨᮌ ᮞᮊᮜᮤᮠ᮪. ᮙᮧ ᮙ ᮘᮨᮅᮔᮔ᮪ᮌ᮪ ᮅᮛᮔ᮪ᮌ᮪ _ _ ᮂᮃ ᮞᮓᮥ ᮘ᮪éᮙ ᮙ᮪éᮔ᮪ᮒ. cᮇcᮇᮃᮔ᮪, ᮒᮤᮠᮕ᮪ ᮅᮜᮠ᮪ ᮙᮨᮅᮜᮤ ᮔᮥᮊᮨᮅᮁ. ᮕᮊᮛᮔ᮪ᮌ᮪ ᮒᮤᮠᮕ᮪ ᮅᮜᮠ᮪ ᮔ᮪ᮌᮤᮔ᮪ᮏᮨᮅᮙ᮪ ᮞᮤᮙ᮪ᮘᮥᮒ᮪, cᮃwᮈᮒ᮪, ᮒᮤᮠᮕ᮪ ᮅᮜᮠ᮪ ᮞᮛᮒ. ᮠᮊᮔ᮪ ᮄᮔᮥᮙ᮪ ᮅᮜᮠ᮪</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila kita akan membuat sawah agar jangan sengsara; bila kita akan membuat kebun agar jangan memetik sayuran ke ladang kecil atau ke ladang luas milik orang lain (sebab) kita tak dapat mohon izin meminta; memelihara ternak agar jangan membeli atau menukar (barter); (memiliki) perkakas (atau perabotan), agar jangan meminjam selimut cawat, sekadar jangan kekurangan; makan dan minum jangan</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jaga urang ngajadikeun sawah tihap ulah sangsara. jaga rang nyieun kebon, tihap ulah ngundeur ka huma béét sakalih, ka huma lega sakalih. mo ma beunang urang _ _ _ka sadu béma ménta. cocooan, tihap ulah meuli nukeur. pakarang tihap ulah nginjeum simbut, cawet, tihap ulah sarata. hakan inum ulah</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_28"/>
    <lempirNaskah><![CDATA[<A.17r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-27</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_39">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮓ᮪éᮊ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮞᮊᮧéᮠ᮪ ᮔᮤᮔ᮪ᮌ᮪ ᮊwᮄᮠ᮪ ᮙ, ᮊwᮄᮠ᮪ ᮘ᮪wᮃᮒᮥᮠ, ᮊwᮄᮠ᮪ ᮕᮥᮏᮔ᮪ᮌ᮪, ᮊwᮄᮠ᮪ ᮜᮜᮔ᮪ᮌᮥᮃᮔ᮪, ᮊwᮄᮠ᮪ ᮕᮔᮡᮛᮙᮔ᮪, ᮊwᮄᮠ᮪ ᮞᮤᮞᮤᮔ᮪ᮓᮤᮛᮔ᮪, ᮊwᮄᮠ᮪ ᮕ᮪éᮔ᮪ᮌ᮪ᮕ᮪éᮜ᮪éᮓᮔ᮪, ᮘᮧᮔ᮪ᮌ᮪ᮘᮧᮔ᮪ᮌ᮪ ᮊᮞᮧ, ᮕᮧᮁéᮛᮔ᮪é, ᮕᮧᮛᮧᮓ᮪ ᮈᮅᮛᮤᮠ᮪, ᮘᮔᮔ᮪, ᮊwᮄᮠ᮪ ᮘᮔ᮪ᮌ᮪ᮘᮛᮧᮔ᮪ᮌᮔ᮪, ᮊwᮄᮠ᮪ ᮒᮥᮔ᮪ᮌ᮪ᮒᮥᮔ᮪ᮌ᮪, ᮊwᮄᮠ᮪ ᮞᮞᮙ᮪ᮘᮒᮔ᮪, ᮊwᮄᮠ᮪ ᮄᮌᮨᮜ᮪ ᮄᮌᮨᮜᮔ᮪, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮊwᮄᮠ᮪ ᮙ, ᮕᮛᮌᮥᮔ ᮒᮔᮡ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ingin tahu segala macam kawih: kawih bwatuha, kawih panjang, kawih lalanguan, kawih panyaraman, kawih sisindiran, kawih péngpélédan, bongbongkaso, porérané, porod eurih, (kawih babahanan), kawih bangbarongan, kawih tungtung, kawih sasambatan, kawih igel-gelan, segala macam kawih, tanyalah paraguna</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dék nyaho di sakoéh ning kawih ma, kawih bwatuha, kawih pujang, kawih lalanguan, kawih panyaraman, kawih sisindiran, kawih péngpélédan, bongbong kaso, porérané, porod eurih, banan, kawih bangbarongan, kawih tungtung, kawih sasambatan, kawih igel igelan, sing sawatek kawih ma, paraguna tanya.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_40">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮚᮔ᮪ᮌ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮕᮛᮙcᮈᮅᮠ᮪ ᮙ, cᮈᮒ ᮙcᮈᮅᮠ᮪ ᮔᮤᮛᮥᮞ᮪, ᮒᮒᮕᮥᮊᮔ᮪, ᮘᮔ᮪ᮌ᮪ᮘᮛᮧᮔ᮪ᮌᮔ᮪, ᮘᮘᮊᮥᮒᮢᮊᮔ᮪, ᮃᮘᮔ᮪ᮌ᮪-ᮃᮘᮔ᮪ᮌᮔ᮪, ᮔᮨᮅᮛᮨᮅᮚ᮪ ᮕᮔ᮪cᮃ, ᮙᮥᮔᮤᮊᮨᮅᮔ᮪ ᮜᮨᮙ᮪ᮘᮥᮁ, ᮔ᮪ᮌᮓᮥ ᮜᮨᮞᮥᮔ᮪ᮌ᮪, ᮔ᮪ᮌᮓᮥ ᮔᮤᮔᮤ, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮅᮜᮤᮔᮔ᮪, ᮠᮨᮙ᮪ᮕᮥᮜ᮪ ᮒᮔᮡ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ingin tahu permainan, seperti: ceta maceuh, ceta nirus, tatapukan, bangbarongan, babakutrakan, ubang-ubangan, neureuy panca, munikeun lembur, ngadu lesung, ngadu nini, se gala macam permainan, tanyalah hempul.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hayang nyaho di paramaceuh ma, ceta maceuh nirus, tatapukan, bangbarongan, babakutrakan, abang-abangan, neureuy panca, munikeun lembur, ngadu lesung, ngadu nini, sing sawatek ulinan, hempul tanya.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_41"/>
        <lempirNaskah><![CDATA[<A.9r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-40</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<A.8v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-39</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_kebajikan">
    <rdfs:label>kebajikan</rdfs:label>
  </KonsepKamus>
  <owl:Class rdf:about="http://contoh.org/ontology#BagianAjaranMoral">
    <rdfs:label xml:lang="id">Bagian Ajaran Moral</rdfs:label>
    <rdfs:comment xml:lang="id">Baris naskah yang mengandung ajaran moral, etika, tata krama, atau tuntunan hidup.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
  </owl:Class>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_44">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮜᮙᮥᮔ᮪ ᮠᮚᮔ᮪ᮌ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮃᮌᮙ ᮕᮛᮤᮃᮌᮙ, ᮃcᮃᮛ éᮜ᮪éᮠ᮪ ᮊᮥ ᮃᮓᮤᮌᮙ, ᮃᮓᮤᮌᮙ éᮜ᮪éᮠ᮪ ᮊᮥ ᮌᮥᮛᮥᮌᮙ, ᮌᮥᮛᮥᮌᮙ éᮜ᮪éᮠ᮪ ᮊᮥ ᮒᮥᮠᮌᮙ, ᮒᮥᮠᮌᮙ éᮜ᮪éᮠ᮪ ᮊᮥ ᮞᮒ᮪ᮙᮒ, ᮞᮒ᮪ᮙᮒ éᮜ᮪éᮠ᮪ ᮊᮥ ᮞᮥᮛᮊᮣᮧᮊ, ᮞᮥᮛᮊᮣᮧᮊ éᮜ᮪éᮠ᮪ ᮊᮥ ᮔwᮄcᮃᮛᮠ᮪. ᮅᮒᮙ ᮏᮔ᮪ᮙ wᮃᮠ᮪éᮃ ᮓᮧᮞ, wᮃᮠ᮪éᮃ ᮏᮔ᮪ᮙ ᮅᮒᮙ ᮓᮧᮞ. ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮃᮌᮙ, ᮕᮛᮒᮓ ᮒᮔᮡ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ingin tahu agama dan parigama, acara tunduk kepada adigama, adigama tunduk kepada gurugama, gurugama tunduk kepada tuhagama, tuhagama tunduk kepada satmata, satmata tunduk kepada surakloka, surakloka tunduk kepada nawicarah. Keutamaan manusia bebas dari dosa, (ciri) manusia utama (terbebas dari) dosa, segala hal mengenai agama, pretanda tanya.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lamun hayang nyaho di agama pariagama, acara éléh ku adigama, adigama éléh ku gurugama, gurugama éléh ku tuhagama, tuhagama éléh ku satmata, satmata éléh ku surakloka, surakloka éléh ku nawicarah. utama janma wahéa dosa, wahéa janma utama dosa. sing sawatek agama, paratada tanya.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lempirNaskah><![CDATA[<A.10v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-44</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_19">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮃᮚ ᮓᮨᮅᮄ ᮜᮙᮥᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮡᮨᮅᮈᮅᮔ᮪ᮌ᮪ ᮔᮥ ᮔ᮪ᮌᮓᮜᮔ᮪ᮌ᮪ ᮔ᮪ᮌwᮃᮚᮔ᮪ᮌ᮪, ᮔ᮪ᮌᮓ᮪éᮔ᮪ᮌ᮪éᮊᮨᮅᮔ᮪ ᮔᮥ ᮙᮔ᮪ᮒᮥᮔ᮪, ᮔᮨᮙᮥ ᮞᮤᮊ᮪ᮞᮔ᮪</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ada lagi jika kita menonton yang sedang mendalang memainkan wayang, mendengarkan juru pantun,</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aya deui lamun urang nyeueung nu ngadalang ngawayang, ngadéngékeun nu mantun, nemu siksaan</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_20">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮒᮤᮔ cᮃᮛᮤᮒ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮕᮔ᮪ᮌ᮪ᮌᮥᮔ᮪ᮌ᮪ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮜᮙᮥᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮨᮙᮥ ᮞᮤᮊ᮪ᮞᮔ᮪ ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮙ ᮒᮤ ᮔᮥ ᮙcᮃ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮒᮔ᮪ᮌ᮪ᮒᮥ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮜᮙᮥᮔ᮪ ᮙᮤᮛᮨᮅᮔ᮪ᮌᮨᮅᮠ᮪ ᮘᮨᮅᮔᮔ᮪ᮌ᮪ ᮓᮤᮊᮥᮁᮚᮊ᮪, ᮙ: ᮅᮊᮤᮁ-ᮅᮊᮤᮛᮔ᮪, ᮕᮕᮠᮒᮔ᮪, ᮕᮕᮓᮥᮔ᮪ᮌᮔ᮪, ᮒᮥᮒᮥᮜᮤᮞᮔ᮪, ᮞᮥᮄ ᮔᮔᮡ ᮊ ᮔᮥ ᮓᮤᮊᮥᮁᮚᮊ᮪, ᮒᮨᮙᮥ ᮊᮥ ᮛᮞ ᮞᮧᮛᮔ᮪ᮌᮔ᮪ ᮊᮥ ᮘᮨᮅᮔᮔ᮪ᮌ᮪ᮔ ᮄᮜᮤᮊ᮪ ᮓᮤ ᮌᮥᮔ ᮞᮊᮜᮤᮠ᮪, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ wᮛᮨᮒᮤ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮔᮨᮙᮥ ᮃᮌᮙ ᮒᮤ ᮃᮔᮊ᮪ ᮙ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮛᮁé ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮔᮨᮙᮥ ᮓᮁᮙ ᮒᮤ ᮃᮊᮤ ᮙ ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮊᮊᮤ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮔᮨᮙᮥ ᮓᮁᮙ ᮒᮤ ᮜᮔ᮪cᮈᮅᮊ᮪ ᮙ, ᮔ᮪ᮌᮛᮔ᮪ᮔ ᮌᮥᮛᮥ ᮊᮊᮔ᮪ᮌ᮪. ᮔᮨᮙᮥ ᮓᮁᮙ ᮒᮤ ᮒᮧᮃ ᮙ, ᮚ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮥᮛᮥ ᮅᮃ ᮔ᮪ᮌᮛᮔ᮪ᮔ. ᮔᮨᮙᮥ ᮓᮁᮙ ᮒᮤ ᮌᮨᮅᮞᮔ᮪ ᮜᮥᮙᮨᮅᮙ᮪ᮕᮔ᮪ᮌ᮪ ᮙ, ᮔ᮪ᮌᮛᮔ᮪ᮔ, ᮓᮤ ᮜᮨᮙ᮪ᮘᮥᮁ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dari kisahnya, itu disebut guru panggung namanya, Bila kita menemukan pelajaran yang baik dari membaca, itu disebut guru tangtu namanya, Bila memperhatikan dengan seksama hasil pekerjaan besar seperti ukir-ukiran, hasil pahatan, papadungan (pertukangan kayu), tulisan (lukisan), tanpa bertanya kepada pembuatnya, terpahami oleh rasa sendiri dari hasil mengamati karya orang lain, itu disebut guru wreti namanya, Mendapat ilmu dari anak, itu disebut guru raré namanya. Mendapat pelajaran dari kakek, itu disebut guru kaki namanya, Mendapat pelajaran dari kakak, itu namanya guru kakang, Mendapat palajaran dari toa, itu disebut guru ua, Mendapat pelajaran di tempat bepergian, seperti di kampung</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tina carita, ya kangken guru panggung ngaranna. lamun urang nemu siksaan rampés ma ti nu maca, ya kangken guru tangtu ngaranna. lamun mireungeuh beunang dikuryak, ma: ukir-ukiran, papahatan, papadungan, tutulisan, sui nanya ka nu dikuryak, temu ku rasa sorangan ku beunangna ilik di guna sakalih, ya kangken guru wreti ngaranna. nemu agama ti anak ma, ya kangken guru raré ngaranna. nemu darma ti aki ma ngaranna, ya kangken guru kaki ngaranna. nemu darma ti lanceuk ma, ngaranna guru kakang. nemu darma ti toa ma, ya kangken guru ua ngaranna. nemu darma ti geusan lumeumpang ma, ngaranna, di lembur</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_21"/>
        <lempirNaskah><![CDATA[<A.4r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-20</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<A.3v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-19</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_24">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ᮓᮒᮔ᮪ᮌ᮪ ᮔᮥ ᮙᮨᮛᮨ ᮞᮨᮅᮕᮠᮨᮅᮔ᮪] ᮚ ᮒ ᮞᮤᮔᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮕᮔ᮪cᮃ ᮕᮛᮤᮞᮥᮓ ᮔ᮪ᮌᮛᮔ᮪ᮔ. éᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮌᮜᮠ᮪ cᮈᮓᮨᮊ᮪ ᮒᮤᮔᮥᮌᮨᮜᮔ᮪ ᮒᮨᮊ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yaitu yang disebut panca parisuda (lima penawar); itulah perumpamaan galah pendek yang dipotong</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[datang nu mere seupaheun] ya ta sinangguh panca parisuda ngaranna. éta kangken galah cedek tinugelan teka.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_25"/>
    <lempirNaskah><![CDATA[<A.16v:1>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-24</dcterms:identifier>
  </BagianAjaranMoral>
  <owl:Class rdf:about="http://contoh.org/ontology#KonsepKamus">
    <rdfs:label xml:lang="id">Konsep Kamus</rdfs:label>
    <rdfs:comment xml:lang="id">Kelas untuk merepresentasikan konsep kata atau sinonim dalam kamus semantik.</rdfs:comment>
  </owl:Class>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_04">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮄᮔᮤ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ ᮊᮢᮨᮒ ᮔᮥ ᮓᮤᮕᮏᮁᮊᮨᮅᮔ᮪ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮓᮞ ᮙᮢᮨᮌ</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inilah buktinya, sang hyang dasa kreta namanya. Bayang-bayang dasa,</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ini sang hyang dasa kreta nu dipajarkeun sang hyang dasa sang hyang dasa mrega</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_05"/>
    <lempirNaskah><![CDATA[<B.3r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-04</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <owl:Class rdf:about="http://contoh.org/ontology#BagianDeskripsiBudaya">
    <rdfs:label xml:lang="id">Bagian Deskripsi Budaya</rdfs:label>
    <rdfs:comment xml:lang="id">Baris naskah yang menjelaskan deskripsi kebudayaan, profesi, pekerjaan, kesenian, tradisi, atau metafora kehidupan.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
  </owl:Class>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_34">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮕᮥᮞ᮪ᮕᮔᮨᮙ᮪ cᮃᮛᮤᮒ ᮘᮔ᮪ᮌ᮪ᮘᮛᮨᮙ᮪</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bunga dikisahkan kumbang</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">puspanem carita bangbarem</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_35"/>
    <lempirNaskah><![CDATA[<A.8r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-34</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_43">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮞwᮃᮜᮥᮛᮔ᮪ ᮔᮤᮔ᮪ᮌ᮪ ᮘᮧéᮠ᮪ ᮙ, ᮊᮨᮙ᮪ᮘᮔ᮪ᮌ᮪ ᮙᮥᮔ᮪cᮃᮔ᮪ᮌ᮪, ᮌᮌᮔ᮪ᮌ᮪ ᮞ᮪éᮔ᮪ᮌ᮪ᮌᮔ᮪ᮌ᮪, ᮞᮙ᮪éᮜ᮪éᮌ᮪, ᮞᮨᮅᮙᮒ᮪ ᮞᮠᮥᮛᮥᮔ᮪, ᮃᮔᮡᮙ᮪ cᮃᮚᮥᮒ᮪, ᮞᮤᮌᮨᮏᮤ, ᮕᮞᮤ-ᮕᮞᮤ, ᮊᮜᮔ᮪ᮌ᮪ᮊᮔ᮪ᮌ᮪ ᮃᮚᮊᮔ᮪, ᮕᮧᮜ᮪éᮔ᮪ᮌ᮪ ᮛᮨᮔ᮪ᮌ᮪ᮌᮔᮤᮞ᮪, ᮏᮚᮔ᮪ᮒᮤ, cᮄcᮄwᮃᮔ᮪, ᮕᮕᮛᮔᮊᮔ᮪, ᮙᮔ᮪ᮌᮤᮔ᮪ ᮠᮛᮤᮞ᮪, ᮞᮜᮤᮔ᮪ ᮌᮔ᮪ᮒᮤ, ᮘᮧéᮠ᮪ ᮞ᮪éᮃᮔ᮪, ᮘᮨᮘᮨᮔᮒᮔ᮪, ᮕᮕᮊ᮪ᮔᮊᮔᮔ᮪, ᮞᮥᮛᮒ᮪ ᮃwᮄ, ᮕᮛᮤᮌᮤ ᮔᮡ᮪éᮔ᮪ᮌ᮪ᮞᮧᮠ᮪, ᮌᮌᮏᮛᮔ᮪, ᮜᮥᮞᮤᮃᮔ᮪ ᮘᮨᮞᮁ, ᮊᮙᮛᮥᮔ᮪ᮌ᮪ ᮏᮚᮔ᮪ᮒᮤ, ᮠᮥᮏᮔ᮪ ᮛᮤᮛᮤᮞ᮪, ᮜᮛᮤᮞ᮪, ᮘᮧéᮠ᮪ ᮃᮜᮥᮞ᮪, ᮛᮌ᮪éᮔ᮪ ᮕᮔ᮪ᮌᮔ᮪ᮒ᮪éᮔ᮪, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮘᮧᮘᮧéᮠᮔ᮪ ᮙ, ᮕᮔ᮪ᮌᮨᮅᮚᮨᮅᮊ᮪ ᮒᮔᮡ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Segala macam kain: kembang muncang, gagang sénggang, samélég, seumat sahurun, anyam cayut, sigeji, pasi-pasi, kalangkang ayakan, poléng rengganis, jayanti, ciciwangan, paparanakan, mangin haris, silihganti, boeh séan, bebenatan, papakna kanan, surat awi, parigi nyéngsoh, gaganjar, lusian besar, kamarung jayanti, hujan riris, boéh alus, ragén pangantén, segala macam kain, pangeuyeuk (penenun) tanya.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sawaluran ning boéh ma, kembang muncang, gagang sénggang, samélég, seumat sahurun, anyam cayut, sigeji, pasi-pasi, kalangkang ayakan, poléng rengganis, jayanti, ciciwaan, paparanakan, mangin haris, salin ganti, boéh séan, bebenatan, papaknakanan, surat awi, parigi nyéngsoh, gagajaran, lusian besar, kamarung jayanti, hujan riris, laris, boéh alus, ragén pangantén, sing sawatek boboéhan ma, pangeuyeuk tanya.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_44"/>
    <lempirNaskah><![CDATA[<A.10v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-43</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_23">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮔᮔ᮪ᮌ᮪ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮓᮒᮔ᮪ᮌ᮪ ᮔᮥ ᮙwᮃᮊᮨᮅᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮃᮛᮧᮒᮨᮅᮔ᮪. ᮅᮕᮙᮔ ᮅᮛᮔ᮪ᮌ᮪ ᮠᮔ᮪ᮓᮨᮅᮈᮅᮜ᮪ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮓᮒᮔ᮪ᮌ᮪ ᮔᮥ ᮙwᮃ ᮞᮨᮅᮕᮠᮨᮅᮔ᮪</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bagaikan datang orang yang mengantarkan minuman; ibarat kita sedang kesal hati bagaikan datang orang yang membawa sirih-pinang</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">naang kangken datang nu mawakeun urang aroteun. upamana urang handeueul kangken datang nu mawa seupaheun</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_24"/>
    <lempirNaskah><![CDATA[<A.5v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-23</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_38">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮊᮜᮤᮔ᮪ᮌᮔ ᮅᮜᮠ᮪ ᮞᮜᮠ᮪ ᮌᮨᮅᮞᮔ᮪ ᮔᮔᮡ. ᮠᮚᮔ᮪ᮌ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮞᮊᮧéᮠ᮪ ᮔᮤᮔ᮪ᮌ᮪ cᮃᮛᮤᮒ ᮙ, ᮌᮨᮅᮞ᮪ ᮓᮁᮙᮏᮒᮤ, ᮞᮔ᮪ᮌ᮪ ᮠᮡᮔ᮪ᮌ᮪ ᮠᮚᮥ, ᮞ᮪éᮓᮙᮔ, ᮊᮥᮔᮡ᮪ᮏᮚᮊᮁᮔ, ᮛᮙᮚᮔ, ᮃᮓᮤᮕᮁwᮃ, ᮊᮧᮛwᮃᮞᮢᮙ, ᮘᮤᮙᮞᮧᮁᮌ, ᮛᮔ᮪ᮌ᮪ᮌ ᮜwé, ᮘᮧᮙ, ᮞᮥᮙᮔ, ᮊᮜ ᮕᮥᮁᮘᮊ, ᮏᮛᮤᮔᮤ, ᮒᮔ᮪ᮒᮢᮤ, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ cᮃᮛᮤᮒ ᮙ, ᮙ᮪éᮙ᮪éᮔ᮪ ᮒᮔᮡ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maksudnya janganlah salah tempat untuk bertanya. Bila ingin tahu semua cerita: Damarjati, Sanghyang Hayu, Sedamana, Kunjayakarma, Ramayana, Adiparwa, Korawasarma, Bimasorga, Rangga Lawe, Boma, Sumana, Kala Purbaka, Jarini, Tantri, segala macam cerita, tanyalah mémén (dalang)</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kalingana ulah salah geusan nanya. hayang nyaho di sakoéh ning carita ma, geus darmajati, sang hyang hayu, sédamana, kunyjayakarna, ramayana, adiparwa, korawasrama, bimasorga, rangga lawé, boma, sumana, kala purbaka, jarini, tantri, sing sawatek carita ma, mémén tanya.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_39"/>
    <lempirNaskah><![CDATA[<A.8v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-38</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_41">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮚᮔ᮪ᮌ᮪ ᮔᮡᮠᮧ ᮓᮤ ᮕᮔ᮪ᮒᮥᮔ᮪ ᮙ, ᮜᮔ᮪ᮌ᮪ᮌᮜᮛᮔ᮪ᮌ᮪, ᮘᮔᮡᮊ᮪cᮃᮒᮢ, ᮞᮤᮜᮤᮠ᮪wᮃᮔ᮪ᮌᮤ, ᮕᮢᮨᮕᮔ᮪ᮒᮥᮔ᮪ ᮒᮔᮡ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ingin tahu tentang pantun: Langgalarang, Banyakcatra, Siliwangi, tanyalah prepantun (juru pantun).</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hayang nyaho di pantun ma, langgalarang, banyakcatra, silihwangi, prepantun tanya.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_42">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮞwᮃᮜᮥᮛᮔ᮪ᮔᮤᮔ᮪ᮌ᮪ ᮒᮥᮜᮤᮞ᮪ ᮙ, ᮕᮥᮕᮥᮔ᮪ᮏᮨᮔ᮪ᮌᮔ᮪ ᮒᮔᮡ, ᮃᮞᮥᮕ᮪ ᮊᮔ ᮌᮒᮤ, ᮠᮤᮌᮥᮜ᮪-ᮠᮤᮌᮥᮜᮔ᮪, ᮊᮨᮊᮨᮙ᮪ᮘᮔ᮪ᮌᮔ᮪, ᮃᮜᮞ᮪-ᮃᮜᮞᮔ᮪, ᮅᮛᮔ᮪ᮌ᮪-ᮅᮛᮔ᮪ᮌᮔ᮪, ᮘᮤᮘᮤᮜᮠᮔ᮪, ᮞᮨᮞᮨᮛᮔ᮪ᮌᮔ᮪, ᮒᮒᮛᮥ ᮠᮒ, ᮃ ᮊᮨᮙ᮪ᮘᮔ᮪ᮌ᮪ ᮒᮛᮒ᮪é, ᮞᮤᮔ᮪ᮌ᮪ ᮞwᮃᮒᮨᮊ᮪ ᮒᮥᮜᮤᮞ᮪ ᮙ, ᮜᮥᮊᮤᮞ᮪ ᮒᮔᮡ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Segala macam tulis (motif lukisan), seperti: pupunjengan, higul-higulan, kekembangan, alas-alasan, urang-urangan, beubeulahan, seserangan, tataru hata, kembang taraté, segala macam tulis (lukisan), tanyalah lukis.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sawaluranning tulis ma, pupunjengan tanya, asup kana gati, higul-higulan, kekembangan, alas-alasan, urang-urangan, bibilahan, seserangan, tataru hata, a kembang taraté, sing sawatek tulis ma, lukis tanya.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_43"/>
        <lempirNaskah><![CDATA[<A.9r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-42</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<A.9r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-41</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_30">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮞᮅᮁ ᮞᮔ᮪ᮌ᮪ ᮓᮁᮙ ᮕᮤᮒᮥᮒᮥᮁ, ᮄᮔᮤ ᮞᮤᮜᮧᮊᮔ</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ucapan sang darma pitutur. Inil selokannya</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saur sang darma pitutur, ini silokana</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_31">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮒᮒᮊ cᮃᮛᮤᮒ ᮠᮔ᮪ᮌ᮪ᮞ,</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telaga dikisahkan angsa,</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tataka carita hangsa,</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_32"/>
        <lempirNaskah><![CDATA[<A.8r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-31</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </lanjutKeBaris>
    <lempirNaskah><![CDATA[<A.8r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-30</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_26">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮄᮔᮤ ᮕᮔ᮪ᮌᮤᮙ᮪ᮘᮥᮠ᮪ ᮔᮤᮔ᮪ᮌ᮪ ᮒ᮪wᮃᮠ᮪ ᮕᮊᮨᮅᮔ᮪ wᮃᮞ᮪ᮒᮥ ᮞᮊᮜ ᮙᮔ᮪ᮌᮥᮛᮤᮕ᮪, ᮕᮊᮨᮅᮔ᮪ wᮃᮞ᮪ᮒᮥ ᮓᮤ ᮄᮙᮠ᮪ ᮓᮤ ᮙᮔ᮪éᮠ᮪. éᮙ᮪éᮒ᮪ ᮄᮙᮨᮅᮒ᮪, ᮛᮏᮤᮔ᮪, ᮜᮨᮅᮊᮨᮅᮔ᮪, ᮕᮊ ᮕᮢᮨᮓᮔ, ᮙᮧᮛᮧᮌᮧᮜ᮪ ᮛᮧᮌᮧᮜ᮪, ᮕᮥᮛᮞ wᮄᮓᮌ᮪ᮓ, ᮠᮕᮤᮒᮔ᮪, ᮊᮛwᮃᮜ᮪éᮃ, cᮃᮔ᮪ᮌ᮪cᮄᮔ᮪ᮌᮔ᮪, ᮜᮔ᮪ᮌ᮪ᮞᮤᮒᮔ᮪.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ini pelengkap perbuatan agar berhasil dalam menjalani hidup agar berhasil di rumahmu: émét (cermat), imeut (teliti), rajin, leukeun (tekun), paka predana (cukup sandang), morogol-rogol (bersemangat), purasa widagda (berjiwa pahlawan), hapitan (bijaksana), karawaléa (dermawan), cangcingan (cekatan), langsitan (terampil)</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ini pangimbuh ning twah pakeun wastu sakala manghurip, pakeun wastu di imah di manéh. émét imeut, rajin, leukeun, paka predana, morogol rogol, purasa widagda, hapitan, karawaléa, cangcingan, langsitan.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_27"/>
    <lempirNaskah><![CDATA[<A.17r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-26</dcterms:identifier>
  </BagianAjaranMoral>
  <owl:Class rdf:about="http://contoh.org/ontology#BagianPembuka">
    <rdfs:label xml:lang="id">Bagian Pembuka</rdfs:label>
    <rdfs:comment xml:lang="id">Baris naskah yang berisi bagian pembuka, pengantar, atau kolofon naskah.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
  </owl:Class>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_05">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮠᮔ ᮙ ᮒᮥᮍ᮪ᮌᮥᮜ᮪ᮔ, ᮃᮚ ᮒᮥ ᮎᮒ᮪ᮍ᮪ᮔ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ada tunggulnya, maka ada pula pohon tumbangnya.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hana ma tunggulna, aya tu catangna.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_06"/>
    <lempirNaskah><![CDATA[<L.2r>]]></lempirNaskah>
    <dcterms:identifier>AG-BARIS-05</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_07">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮙᮥᮜᮠ᮪ ᮞᮤᮜᮤᮠ᮪ ᮕᮘᮨᮔ᮪ᮎᮔ᮪ ᮞᮤᮜᮤᮠ᮪ ᮕᮔ᮪ᮎᮔ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janganlah saling bertengkar, saling memfitnah.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mulah silih pabencan silih pancan.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_08"/>
    <lempirNaskah><![CDATA[<L.2v>]]></lempirNaskah>
    <dcterms:identifier>AG-BARIS-07</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_21">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮜᮤᮠ᮪. ᮜᮙᮥᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮓéᮊ᮪ ᮓᮤᮕᮥᮏᮤ ᮙ, ᮊᮓᮡᮔ᮪ᮌ᮪ᮌᮔᮤᮔ᮪ᮌ᮪ ᮌᮜᮠ᮪ ᮓwᮃ ᮞᮤᮔᮙ᮪ᮘᮥᮔ᮪ᮌᮔ᮪ ᮒᮥ ᮔ, ᮛᮞ ᮃᮒᮧᮠ᮪ ᮊᮥ ᮕᮙᮥᮏᮤ. ᮃᮔ᮪ᮌ᮪ᮌᮨᮅᮞ᮪ ᮙ ᮓᮤᮕᮊ᮪é ᮠᮔ᮪ᮌ᮪ᮊᮛ, ᮏ ᮔ᮪ᮌᮛᮞ ᮙᮔ᮪éᮠ᮪ ᮃᮚ ᮓᮤ ᮄᮙᮠ᮪ ᮓᮤ ᮙᮔ᮪éᮠ᮪, ᮊᮥ ᮠᮊᮔ᮪ ᮊᮥ ᮄᮔᮥᮙ᮪, ᮊᮥ ᮞᮥᮊ ᮘᮧᮌ, ᮊᮥ ᮕᮊᮛᮔ᮪ᮌ᮪, ᮒ᮪éᮊ ᮓᮤᮕᮊ᮪é ᮃᮔ᮪ᮌ᮪ᮌᮨᮅᮠᮨᮅᮔ᮪. éᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ᮌ᮪ ᮌᮜᮠ᮪ ᮓwᮃ ᮒ. éᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮕᮁé ᮠᮕ ᮒ ᮔ᮪ᮌᮛᮔ᮪ᮔ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jika kita ingin dipuji, itu ibarat galah panjang disambung ranting (belalai), karena merasa senang oleh pujian, Lalu menjadi sombong, karena merasa diri berkecukupan di rumah sendiri oleh makanan, oleh minuman, oleh kesenangan harta, oleh perabotan, lalu dipakai untuk andalan, Itu disebut galah panjang, Itu ibarat padi hampa namanya.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lih. lamun urang daék dipuji ma, kadyangganing galah dawa sinambungan tu na, rasa atoh ku pamuji. anggeus ma dipaké hangkara, ja ngarasa manéh aya di imah di manéh, ku hakan ku inum, ku suka boga, ku pakarang, téka dipaké anggeuheun. éta kangkeng galah dawa ta. éta kangken paré hapa ta ngaranna.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_22"/>
    <lempirNaskah><![CDATA[<A.5r>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-21</dcterms:identifier>
  </BagianAjaranMoral>
  <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_37">
    <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮊᮜᮤᮔ᮪ᮌᮔ ᮒ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮘᮔ᮪ᮌ᮪ᮘᮛ ᮒ ᮙ, ᮏᮔ᮪ᮙ ᮘᮤᮞ ᮞᮘ ᮔ᮪ᮌᮥᮙ᮪ᮘᮛ, ᮔᮡᮠᮧ ᮓᮤ ᮒᮤᮔᮨᮅᮔ᮪ᮌ᮪ ᮞᮊᮜᮤᮠ᮪ ᮊᮔ᮪ᮌ᮪ᮊᮨᮔ᮪ ᮛᮥᮙ᮪ ᮊᮨᮙ᮪ᮘᮔ᮪ᮌ᮪ ᮒ ᮙ, ᮏᮔ᮪ᮙ ᮛᮙ᮪ᮕ᮪éᮞ᮪ ᮒ᮪wᮃᮠ᮪, ᮃᮞᮤᮔ᮪ᮌ᮪ ᮘᮛᮥᮔ᮪ᮌᮥᮞᮔ᮪, ᮞᮨᮙᮥ ᮌᮥᮚᮥ ᮒᮤᮔ᮪ᮌ᮪ᮊᮠ᮪ ᮞᮥᮊ.</hasAksara>
    <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maksudnya yang diibaratkan kumbang itu ialah orang dapat pergi mengembara, tahu perilaku orang lain. Yang diibaratkan ha rum bunga ialah manusia yang sempurna tingkah lakunya, manis tutur katanya, selalu tampak tersenyum penuh kebahagiaan.</hasTranslation>
    <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kalingana ta kangken bangbara ta ma, janma bisa saba ngumbara, nyaho di tineung sakalih kangken ruum kembang ta ma, janma rampés twah, asing barungusan, semu guyu tingkah suka.</hasTransliteration>
    <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
    <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_38"/>
    <lempirNaskah><![CDATA[<A.8v>]]></lempirNaskah>
    <dcterms:identifier>SKK-BARIS-37</dcterms:identifier>
  </BagianDeskripsiBudaya>
  <owl:Class rdf:about="http://contoh.org/ontology#EntriLeksikal">
    <rdfs:label xml:lang="id">Entri Leksikal</rdfs:label>
    <rdfs:comment xml:lang="id">Kelas yang merepresentasikan satu entri kata (lema) Sunda Kuno beserta artinya dalam bahasa Indonesia.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://contoh.org/ontology#Manuskrip">
    <rdfs:label xml:lang="id">Manuskrip</rdfs:label>
    <rdfs:comment xml:lang="id">Kelas yang mewakili naskah atau manuskrip kuno secara keseluruhan.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://contoh.org/ontology#BarisNaskah">
    <rdfs:label xml:lang="id">Baris Naskah</rdfs:label>
    <rdfs:comment xml:lang="id">Kelas utama yang mewakili setiap baris teks di dalam manuskrip.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
