    <rdfs:label xml:lang="id">Kata Sunda Kuno</rdfs:label>
    <rdfs:comment xml:lang="id">Bentuk transliterasi Latin dari kata Sunda Kuno.</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#EntriLeksikal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://contoh.org/ontology#hasPart">
    <rdfs:label xml:lang="id">Memiliki Bagian</rdfs:label>
    <rdfs:comment xml:lang="id">Menghubungkan manuskrip dengan baris-baris naskah di dalamnya.</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#Manuskrip"/>
    <rdfs:range rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
    <owl:inverseOf>
      <owl:FunctionalProperty rdf:about="http://contoh.org/ontology#isFromManuscript">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <rdfs:label xml:lang="id">Berasal Dari Manuskrip</rdfs:label>
        <rdfs:comment xml:lang="id">Menghubungkan baris naskah dengan manuskrip asalnya.</rdfs:comment>
        <rdfs:domain rdf:resource="http://contoh.org/ontology#BarisNaskah"/>
        <rdfs:range rdf:resource="http://contoh.org/ontology#Manuskrip"/>
      </owl:FunctionalProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_munuh">
    <kataSunda>munuh</kataSunda>
    <aksaraKata>ᮙᮥᮔᮥᮂ</aksaraKata>
    <artiIndonesia>membunuh</artiIndonesia>
    <kelasKata>verba</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_08">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮙᮥᮜᮠ᮪ ᮙᮥᮔᮥᮠ᮪ ᮔᮥ ᮠᮔ᮪ᮒᮨᮥ ᮓᮧᮞ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janganlah membunuh orang yang tidak berdosa.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mulah munuh nu hanteu dosa.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_09"/>
        <lempirNaskah><![CDATA[<L.2v>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-08</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_talaga">
    <kataSunda>talaga</kataSunda>
    <aksaraKata>ᮒᮜᮌ</aksaraKata>
    <artiIndonesia>telaga; danau</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_35"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_beuheula">
    <kataSunda>beuheula</kataSunda>
    <aksaraKata>ᮘᮩᮠᮩᮜ</aksaraKata>
    <artiIndonesia>masa lampau; dahulu kala</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_03">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮃᮚ ᮙ ᮘᮨᮥᮠᮨᮥᮜ ᮃᮚ ᮒᮥ ᮃᮚᮨᮥᮔ, ᮠᮔ᮪ᮒᮨᮥ ᮙ ᮘᮨᮥᮠᮨᮥᮜ ᮠᮔ᮪ᮒᮨᮥ ᮒᮥ ᮃᮚᮨᮥᮔ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bila ada masa lampau maka ada masa kini, bila tidak ada masa lampau tidak ada masa kini.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aya ma beuheula aya tu ayeuna, hanteu ma beuheula hanteu tu ayeuna.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_04"/>
        <lempirNaskah><![CDATA[<L.1v>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-03</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <owl:ObjectProperty rdf:about="http://contoh.org/ontology#hasSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="id">Memiliki Sinonim Semantik</rdfs:label>
    <rdfs:comment xml:lang="id">Menghubungkan suatu konsep kata dengan konsep sinonimnya secara simetris dan transitif.</rdfs:comment>
    <rdfs:domain rdf:resource="http://contoh.org/ontology#KonsepKamus"/>
    <rdfs:range rdf:resource="http://contoh.org/ontology#KonsepKamus"/>
  </owl:ObjectProperty>
  <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_manuskrip">
    <rdfs:label>manuskrip</rdfs:label>
    <hasSynonym>
      <KonsepKamus rdf:about="http://contoh.org/ontology#konsep_naskah">
        <rdfs:label>naskah</rdfs:label>
      </KonsepKamus>
    </hasSynonym>
  </KonsepKamus>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_mata">
    <kataSunda>mata</kataSunda>
    <aksaraKata>ᮙᮒ</aksaraKata>
    <artiIndonesia>mata</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#skk_baris_05">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cᮈᮅᮜᮤ ᮙᮥᮜᮠ᮪ ᮞᮜᮠ᮪ ᮓ᮪éᮔ᮪ᮌ᮪é ᮙᮧ ᮙ ᮔᮥ ᮞᮤᮈᮅᮕ᮪ ᮓᮤᮓ᮪éᮔ᮪ᮌ᮪é, ᮊᮨᮔ ᮔ ᮊᮔ, ᮞᮔ᮪ᮌ᮪ᮊᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮨᮙᮥ ᮙᮜ ᮜᮙᮥᮔ᮪ᮔ ᮊᮕᮠᮚᮥ ᮙ ᮞᮤᮔᮨᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮅᮒᮙ ᮘᮤᮏᮤᮜ᮪ ᮒᮤ ᮕᮔ᮪ᮌᮢᮨᮅᮔ᮪ᮌᮨᮅ, ᮙᮒ ᮙᮥᮜᮠ᮪ ᮞᮜᮠ᮪ ᮓᮨᮅᮜᮨᮅ ᮙᮧ ᮙ ᮔᮥ ᮞᮤᮈᮅᮕ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮨᮙᮥ ᮙᮜ, ᮔ ᮜᮥᮔᮞ᮪ ᮕᮕ ᮊᮜ᮪éᮞ, ᮠ᮪éᮔ᮪ᮌᮔ᮪ ᮜᮙᮥᮔ᮪ᮔ ᮊᮕᮠᮚᮥ ᮙ, ᮞᮤᮔᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮅᮒᮙ ᮘᮤᮏᮤᮜ᮪ ᮒᮤ ᮔᮔ ᮓᮧᮛ ᮘᮔ᮪cᮃᮔ, ᮞᮔ᮪ᮌ᮪ᮊᮔ᮪ ᮅᮛᮔ᮪ᮌ᮪ ᮔᮨᮙᮥ ᮙᮜ, ᮔ ᮜᮥᮔᮞ᮪ ᮕᮕ ᮔᮛᮊ, ᮠ᮪éᮔ᮪ᮌᮔ᮪ ᮜᮙᮥᮔ᮪ ᮊᮕᮠᮚᮥ ᮙ, ᮞᮤᮔᮨᮔ᮪ᮌ᮪ᮌᮥᮠ᮪ ᮅᮒᮙ</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telinga jangan mendengarkan yang tidak layak didengar, karena penyebab kita mendapat celaka tapi jika telinga terpeliharamaka disebut sebagai keutamaan dari pendengaran, Mata jangan sembarang melihat yang tidak layak dipandang kita mendapat celaka, di dasar kenistaan, tapi bila mata terpelihara, maka disebut keutamaan dari menjadi pintu bencana, penyebab kita mendapat celaka di dasar kenistaan neraka, tetapi jika terpelihara, maka disebut keutamaan</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ceuli mulah salah déngé mo ma nu sieup didéngé, kena na kana, sangkan urang nemu mala lamunna kapahayu ma sinengguh utama bijil ti pangreungeu, mata mulah salah deuleu mo ma nu sieup urang nemu mala, na lunas papa kalésa, héngan lamunna kapahayu ma, sinangguh utama bijil ti nana dora bancana, sangkan urang nemu mala, na lunas papa naraka, héngan lamun kapahayu ma, sinengguh utama</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_06"/>
        <lempirNaskah><![CDATA[<B.3v>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-05</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_buruan">
    <kataSunda>buruan</kataSunda>
    <aksaraKata>ᮘᮥᮛᮥᮃᮔ᮪</aksaraKata>
    <artiIndonesia>halaman rumah</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_03"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_ceuli">
    <kataSunda>ceuli</kataSunda>
    <aksaraKata>ᮎᮩᮜᮤ</aksaraKata>
    <artiIndonesia>telinga</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_05"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_sagara">
    <kataSunda>sagara</kataSunda>
    <aksaraKata>ᮞᮌᮛ</aksaraKata>
    <artiIndonesia>laut</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianDeskripsiBudaya rdf:about="http://contoh.org/ontology#skk_baris_33">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮙcᮃᮔᮨᮙ᮪ cᮃᮛᮤᮒ ᮞᮌᮛᮨᮙ᮪,</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ikan mengisahkan laut,</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">macanem carita sagarem,</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#siksaKandangKaresian"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#skk_baris_34"/>
        <lempirNaskah><![CDATA[<A.8r>]]></lempirNaskah>
        <dcterms:identifier>SKK-BARIS-33</dcterms:identifier>
      </BagianDeskripsiBudaya>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_drebya">
    <kataSunda>drebya</kataSunda>
    <aksaraKata>ᮓᮢᮨᮘᮡ</aksaraKata>
    <artiIndonesia>harta; milik</artiIndonesia>
    <kelasKata>nomina</kelasKata>
    <munculDi>
      <BagianAjaranMoral rdf:about="http://contoh.org/ontology#ag_baris_09">
        <hasAksara rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ᮙᮥᮜᮠ᮪ ᮛᮨᮥᮘᮥᮒ᮪ ᮊᮞᮥᮊᮔ᮪ ᮛᮨᮥᮘᮥᮒ᮪ ᮓᮢᮨᮘᮡ.</hasAksara>
        <hasTranslation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janganlah berebut kebahagiaan, berebut harta milik.</hasTranslation>
        <hasTransliteration rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mulah rebut kasukan rebut drebya.</hasTransliteration>
        <isFromManuscript rdf:resource="http://contoh.org/ontology#amanatGalunggung"/>
        <lanjutKeBaris rdf:resource="http://contoh.org/ontology#ag_baris_10"/>
        <lempirNaskah><![CDATA[<L.3r>]]></lempirNaskah>
        <dcterms:identifier>AG-BARIS-09</dcterms:identifier>
      </BagianAjaranMoral>
    </munculDi>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_hayang">
    <kataSunda>hayang</kataSunda>
    <aksaraKata>ᮠᮚᮀ</aksaraKata>
    <artiIndonesia>ingin; mau</artiIndonesia>
    <kelasKata>verba</kelasKata>
    <munculDi rdf:resource="http://contoh.org/ontology#skk_baris_35"/>
  </EntriLeksikal>
  <EntriLeksikal rdf:about="http://contoh.org/ontology#lema_leuweung">
